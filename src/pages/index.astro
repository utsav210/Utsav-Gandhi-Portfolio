---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero';
import AboutSection from '../components/sections/AboutSection';
import ExpertiseSection from '../components/sections/ExpertiseSection';
import ProjectsSection from '../components/sections/ProjectsSection';
import ExperienceSection from '../components/sections/ExperienceSection';
import ServicesSection from '../components/sections/ServicesSection';
import ContactSection from '../components/sections/ContactSection';
import { personalInfo } from '../data/portfolio';

// Utility for formatting section IDs
const toId = (str: string) => str.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<Layout title={`${personalInfo.name} | ${personalInfo.headline}`}>
  <Navbar client:load />
  
  <main>
    <Hero client:load />
    <AboutSection client:visible />
    <ExpertiseSection client:visible />
    <ProjectsSection client:visible />
    <ExperienceSection client:visible />
    <ServicesSection client:visible />
    <ContactSection client:visible />
  </main>
  
  <footer className="py-8 text-center text-text-muted text-sm border-t border-surface-border mt-20 relative z-10 bg-background/80 backdrop-blur-md">
    <p>© {new Date().getFullYear()} {personalInfo.name}. All rights reserved.</p>
  </footer>
</Layout>
