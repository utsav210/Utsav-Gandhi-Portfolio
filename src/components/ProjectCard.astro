---
import { ExternalLink } from 'lucide-react';

interface Props {
  project: {
    title: string;
    role: string;
    outcome: string;
    problem: string;
    solution: string;
    technologies: string[];
    highlights: string[];
    github?: string;
    demo?: string;
  }
}

const { project } = Astro.props;
---

<div class="card-hover p-6 md:p-8 flex flex-col h-full relative group">
  <div class="mb-6 flex justify-between items-start gap-4">
    <div>
      <h3 class="text-2xl font-bold text-white mb-2 group-hover:text-primary transition-colors">{project.title}</h3>
      <p class="text-sm font-mono text-primary/80">{project.role}</p>
    </div>
    <div class="flex gap-3 text-text-muted">
      {project.github && (
        <a href={project.github} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="GitHub Repository">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
      )}
      {project.demo && project.demo !== "#" && (
        <a href={project.demo} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="Live Demo">
          <ExternalLink class="w-5 h-5" />
        </a>
      )}
    </div>
  </div>

  <div class="space-y-4 mb-6 flex-grow">
    <div>
      <p class="text-text-primary font-medium leading-relaxed mb-4">{project.outcome}</p>
      
      <div class="space-y-3 text-sm text-text-secondary">
        <div>
          <strong class="text-white">Problem:</strong> {project.problem}
        </div>
        <div>
          <strong class="text-white">Approach:</strong> {project.solution}
        </div>
      </div>
    </div>

    <div class="pt-4 border-t border-surface-hover">
      <h4 class="text-sm font-semibold text-white mb-3">Engineering Highlights</h4>
      <ul class="space-y-2">
        {project.highlights.map(highlight => (
          <li class="text-sm text-text-secondary flex items-start">
            <span class="text-primary mr-2 mt-1">▹</span>
            <span>{highlight}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="mt-auto pt-6 flex flex-wrap gap-2">
    {project.technologies.map(tech => (
      <span class="px-2.5 py-1 rounded bg-surface-hover text-xs font-mono text-text-secondary">
        {tech}
      </span>
    ))}
  </div>
</div>
